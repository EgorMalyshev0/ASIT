<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>dosage.press</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d нажатие</string>
			<key>few</key>
			<string>%d нажатия</string>
			<key>many</key>
			<string>%d нажатий</string>
			<key>other</key>
			<string>%d нажатий</string>
		</dict>
	</dict>
	<key>dosage.tablet</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d таблетка</string>
			<key>few</key>
			<string>%d таблетки</string>
			<key>many</key>
			<string>%d таблеток</string>
			<key>other</key>
			<string>%d таблеток</string>
		</dict>
	</dict>
	<key>days.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d день</string>
			<key>few</key>
			<string>%d дня</string>
			<key>many</key>
			<string>%d дней</string>
			<key>other</key>
			<string>%d дней</string>
		</dict>
	</dict>
	<key>days.remaining</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>остался %d день</string>
			<key>few</key>
			<string>осталось %d дня</string>
			<key>many</key>
			<string>осталось %d дней</string>
			<key>other</key>
			<string>осталось %d дней</string>
		</dict>
	</dict>
	<key>days.missed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Пропущен %d день</string>
			<key>few</key>
			<string>Пропущено %d дня</string>
			<key>many</key>
			<string>Пропущено %d дней</string>
			<key>other</key>
			<string>Пропущено %d дней</string>
		</dict>
	</dict>
</dict>
</plist>
